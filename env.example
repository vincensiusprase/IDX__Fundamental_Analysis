# Contoh variabel environment untuk run LOKAL.
# Salin ke .env (yang di-gitignore) ATAU set langsung di shell.

# ID spreadsheet tujuan (opsional; ada default di src/config.py)
# SPREADSHEET_ID=1X2lQYfPC6Dj8WEwbJsXevZgprXw2f2pi_obpTUZFFn8

# Jalankan sebagian sektor saja (opsional). Kosongkan = semua sektor.
# SECTORS=TECHNO,ENERGY

# Untuk run lokal, lebih mudah pakai file service_account.json di root repo
# (sudah masuk .gitignore) daripada menaruh JSON di env var.
# Alternatif: tempel seluruh isi JSON service account ke bawah ini:
# GCP_SA_KEY={"type":"service_account","project_id":"..."}
